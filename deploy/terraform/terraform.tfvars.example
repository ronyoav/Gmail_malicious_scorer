# Copy to terraform.tfvars and adjust as needed. All values have sane defaults,
# so an empty terraform.tfvars works too. Do NOT commit a real terraform.tfvars.

region               = "eu-central-1" # Frankfurt
project              = "phishing-scorer"
asg_desired_capacity = 2
db_multi_az          = true  # set false to halve RDS cost while iterating
instance_type        = "t3.micro"
db_instance_class    = "db.t3.micro"
cache_node_type      = "cache.t3.micro"
